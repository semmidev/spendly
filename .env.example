APP_ENV=development
APP_PORT=8080
APP_NAME=spendly
# debug | info | warn | error — log pipeline email tampil mulai dari info
LOG_LEVEL=info
# PostgreSQL wajib. Contoh lokal: postgres://spendly:spendly@localhost:5432/spendly?sslmode=disable
DATABASE_URL=postgres://spendly:spendly@localhost:5432/spendly?sslmode=disable
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
SESSION_SECRET=dev-session-secret-min-32-chars-xxxx
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI (OpenAI-compatible; OpenAI, OpenRouter, OpenCode Go/Zen) ---
# kosong = parser deterministik lokal (hasil masuk review queue)
AI_API_KEY=
# OpenCode Go ($10/bln). Untuk OpenAI/OpenRouter ganti ke base URL masing-masing.
AI_BASE_URL=https://opencode.ai/zen/go/v1
AI_MODEL=deepseek-v4.1-flash
# deepseek-v4.1-flash = OpenAI-compatible → "chat" (/chat/completions)
# model Zen muse-spark* butuh "responses" (/responses)
AI_API_MODE=chat

# --- Google OAuth (satu client, dua flow) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# Gmail callback = GOOGLE_REDIRECT_URL + /gmail → daftarkan juga di Google Console
# kosongkan FRONTEND_URL untuk SPA satu origin (UI di-embed); isi hanya bila
# frontend di-host terpisah, mis. http://localhost:5173 saat dev Vite.
FRONTEND_URL=

# --- Self-ping anti-sleep (Render free sleep setelah ~15 mnt idle) ---
# Kosong = mati (default dev). Di Render isi URL publik service.
SELF_PING_URL=
# Format durasi Go: 10m aman, 5m agresif, 14m paling hemat.
SELF_PING_INTERVAL=10m
